APP_NAME="Barbearia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados principal: MySQL 8
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barbearia
DB_USERNAME=barbearia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fila de lembretes (processada por: php artisan queue:work)
QUEUE_CONNECTION=database

CACHE_STORE=database

# E-mail: "log" grava as mensagens em storage/logs/laravel.log (nenhum e-mail real é enviado).
# Para envio real, use MAIL_MAILER=smtp e preencha os campos abaixo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="barbearia@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Regras de negócio (ver config/barbearia.php)
BARBEARIA_CANCEL_MIN_HOURS=2

# Usuário administrador criado pelo seeder (defina uma senha forte localmente)
ADMIN_NAME="Barbeiro"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
